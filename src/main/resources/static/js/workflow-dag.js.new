/**
 * 工作流DAG图可视化组件
 * 用于可视化工作流任务的依赖关系和执行状态
 */
class WorkflowDagViewer {
    constructor(containerId, options = {}) {
        this.containerId = containerId;
        this.container = document.getElementById(containerId);
        this.cy = null; // Cytoscape实例
        this.nodes = [];
        this.edges = [];
        this.options = Object.assign({
            layout: 'dagre', // 默认使用dagre布局
            nodeStatusMap: {}, // 节点状态映射
            readOnly: false, // 是否只读模式
            onNodeClick: null, // 节点点击回调
            onEdgeClick: null, // 边点击回调
            // 性能相关配置选项
            performance: {
                maxElementsForAnimation: 200,     // 动画元素数量上限
                maxElementsForTooltips: 500,      // 工具提示元素数量上限
                batchSize: 100,                   // 批处理大小
                largeGraphThreshold: 1000,        // 大型图阈值
                extremelyLargeGraphThreshold: 3000 // 超大型图阈值
            },
            // 自动优化内存选项
            autoOptimize: true,
            // 默认缩放设置
            zoom: {
                min: 0.1,
                max: 2.0,
                sensitivity: 0.1
            }
        }, options);

        // 初始化工具提示元素
        this.tooltip = document.createElement('div');
        this.tooltip.classList.add('cy-tooltip');
        this.tooltip.style.display = 'none';
        document.body.appendChild(this.tooltip);

        // 绑定this到方法
        this.renderGraph = this.renderGraph.bind(this);
        this.updateData = this.updateData.bind(this);
        this.updateNodeStatus = this.updateNodeStatus.bind(this);
        this.getViewableElements = this.getViewableElements.bind(this);
        this.registerEventListeners = this.registerEventListeners.bind(this);
        this.setupTooltips = this.setupTooltips.bind(this);
        this.fitGraph = this.fitGraph.bind(this);
        this.centerGraph = this.centerGraph.bind(this);
        this.exportPNG = this.exportPNG.bind(this);
        this.cleanupMemory = this.cleanupMemory.bind(this);
    }

    /**
     * 初始化DAG图
     */
    init() {
        if (!this.container) {
            console.error('容器元素不存在:', this.containerId);
            return;
        }

        // 创建控制按钮
        this.createControlButtons();

        try {
            // 创建Cytoscape实例
            this.cy = cytoscape({
                container: this.container,
                style: this.getCytoscapeStyle(),
                layout: {
                    name: this.options.layout,
                    rankDir: 'TB', // 从上到下的方向
                    padding: 50,
                    animate: true
                },
                elements: this.getViewableElements(),
                // 恢复默认的滚轮敏感度，以避免异常缩放行为
                wheelSensitivity: this.options.zoom.sensitivity,
                // 设置最小和最大缩放限制以避免内存问题
                minZoom: this.options.zoom.min,
                maxZoom: this.options.zoom.max,
                // 加速渲染设置
                textureOnViewport: this.getTotalElementCount() > this.options.performance.largeGraphThreshold,
                hideEdgesOnViewport: this.getTotalElementCount() > this.options.performance.largeGraphThreshold,
                motionBlur: false,
                pixelRatio: this.getTotalElementCount() > this.options.performance.extremelyLargeGraphThreshold ? 1 : 'auto'
            });

            // 设置工具提示和事件监听器
            this.setupTooltips();
            this.registerEventListeners();

            // 初始布局
            this.fitGraph();
        } catch (error) {
            console.error('初始化DAG图失败:', error);
            this.container.innerHTML = `
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> 
                    无法初始化工作流图: ${error.message}
                </div>`;
        }
    }

    /**
     * 获取Cytoscape样式配置
     */
    getCytoscapeStyle() {
        // 根据是否启用了极限性能模式调整样式
        const isExtremePerformanceMode = this.options._extremePerformanceMode === true;
        
        return [
            {
                selector: 'node',
                style: {
                    'background-color': '#6c757d',
                    'label': isExtremePerformanceMode ? '' : 'data(label)', // 在极限性能模式下不显示标签
                    'text-valign': 'center',
                    'text-halign': 'center',
                    'color': 'white',
                    'text-wrap': 'wrap',
                    'text-max-width': '80px',
                    'font-size': '12px',
                    'width': isExtremePerformanceMode ? '40px' : '100px', // 在极限性能模式下使用更小的节点
                    'height': isExtremePerformanceMode ? '20px' : '40px',
                    'border-width': 1,
                    'border-color': '#555',
                    'shape': 'roundrectangle',
                }
            },
            {
                selector: 'edge',
                style: {
                    'width': 2,
                    'line-color': '#ccc',
                    'target-arrow-color': '#ccc',
                    'target-arrow-shape': 'triangle',
                    'curve-style': isExtremePerformanceMode ? 'straight' : 'bezier', // 在极限性能模式下使用直线而不是贝塞尔曲线
                    'label': isExtremePerformanceMode ? '' : 'data(label)', // 在极限性能模式下不显示边标签
                    'text-rotation': 'autorotate',
                    'font-size': '10px',
                    'color': '#666',
                    'text-background-color': 'white',
                    'text-background-opacity': 0.8,
                    'text-background-padding': '2px'
                }
            },
            {
                selector: '.success',
                style: {
                    'background-color': '#28a745'
                }
            },
            {
                selector: '.running',
                style: {
                    'background-color': '#007bff'
                }
            },
            {
                selector: '.failed',
                style: {
                    'background-color': '#dc3545'
                }
            },
            {
                selector: '.timed-out',
                style: {
                    'background-color': '#ffc107',
                    'color': 'black'
                }
            },
            {
                selector: '.skipped',
                style: {
                    'background-color': '#6c757d'
                }
            },
            {
                selector: '.highlighted',
                style: {
                    'line-color': '#007bff',
                    'target-arrow-color': '#007bff',
                    'width': 3,
                    'opacity': 1
                }
            },
            {
                selector: '.faded',
                style: {
                    'opacity': 0.4
                }
            }
        ];
    }

    /**
     * 创建控制按钮
     */
    createControlButtons() {
        // 创建按钮容器
        const controlsDiv = document.createElement('div');
        controlsDiv.className = 'workflow-controls';
        
        // 创建控制按钮
        const fitButton = document.createElement('button');
        fitButton.className = 'btn btn-sm btn-outline-secondary';
        fitButton.innerHTML = '<i class="fas fa-expand-arrows-alt"></i> 适配';
        fitButton.addEventListener('click', this.fitGraph);
        
        const centerButton = document.createElement('button');
        centerButton.className = 'btn btn-sm btn-outline-secondary';
        centerButton.innerHTML = '<i class="fas fa-compress-arrows-alt"></i> 居中';
        centerButton.addEventListener('click', this.centerGraph);
        
        const exportButton = document.createElement('button');
        exportButton.className = 'btn btn-sm btn-outline-secondary';
        exportButton.innerHTML = '<i class="fas fa-download"></i> 导出';
        exportButton.addEventListener('click', this.exportPNG);
        
        // 添加性能模式切换按钮（当工作流较大时）
        if (this.options._performanceMode) {
            const perfModeButton = document.createElement('button');
            perfModeButton.className = 'btn btn-sm btn-outline-warning';
            perfModeButton.innerHTML = '<i class="fas fa-tachometer-alt"></i> 性能模式已开启';
            perfModeButton.title = '点击切换性能模式';
            perfModeButton.addEventListener('click', () => {
                this.options._performanceMode = !this.options._performanceMode;
                perfModeButton.innerHTML = this.options._performanceMode ? 
                    '<i class="fas fa-tachometer-alt"></i> 性能模式已开启' : 
                    '<i class="fas fa-tachometer-alt"></i> 性能模式已关闭';
                this.renderGraph();
            });
            controlsDiv.appendChild(perfModeButton);
        }
        
        // 添加按钮到容器
        controlsDiv.appendChild(fitButton);
        controlsDiv.appendChild(centerButton);
        controlsDiv.appendChild(exportButton);
        
        // 将控制按钮添加到图容器
        this.container.appendChild(controlsDiv);
    }

    /**
     * 适配图形到视图
     */
    fitGraph() {
        if (this.cy) {
            this.cy.fit();
        }
    }

    /**
     * 获取元素总数
     */
    getTotalElementCount() {
        return this.nodes.length + this.edges.length;
    }

    /**
     * 异步初始化图表
     * 使用setTimeout将初始化任务放入事件队列，避免阻塞UI
     */
    asyncInit() {
        if (!this.container) {
            console.error('容器元素不存在:', this.containerId);
            return Promise.reject('容器元素不存在');
        }

        // 显示加载指示器
        this.container.innerHTML = '<div class="loading-indicator"><i class="fas fa-spinner fa-spin"></i> 正在初始化工作流图...</div>';

        return new Promise((resolve, reject) => {
            setTimeout(() => {
                try {
                    this.init();
                    resolve(this.cy);
                } catch (error) {
                    console.error('异步初始化DAG图失败:', error);
                    reject(error);
                }
            }, 50); // 给UI线程一些时间来渲染
        });
    }

    /**
     * 将图形居中显示
     */
    centerGraph() {
        if (this.cy) {
            this.cy.center();
        }
    }

    /**
     * 导出PNG图像
     */
    exportPNG() {
        if (!this.cy) return;
        
        try {
            const png = this.cy.png({
                output: 'blob',
                bg: 'white',
                scale: 2
            });
            
            const link = document.createElement('a');
            link.href = URL.createObjectURL(png);
            link.download = `工作流图-${new Date().toISOString().slice(0, 19).replace(/[T:]/g, '-')}.png`;
            link.click();
        } catch (error) {
            console.error('导出PNG失败:', error);
            alert('导出失败: ' + error.message);
        }
    }

    /**
     * 获取可视化元素（节点和边）
     */
    getViewableElements() {
        // 使用一次性预分配内存空间，避免频繁的内存分配
        const totalElements = this.nodes.length + this.edges.length;
        const elements = new Array(totalElements);
        let index = 0;
        
        // 仅在极限性能模式下进行抽样
        const isExtremePerfMode = this.options._extremePerformanceMode === true;
        const sampleRate = isExtremePerfMode ? Math.max(1, Math.floor(this.nodes.length / 300)) : 1;
        
        // 添加节点
        for (let i = 0; i < this.nodes.length; i++) {
            // 在极限性能模式下进行抽样
            if (isExtremePerfMode && (i % sampleRate !== 0) && !this.isImportantNode(this.nodes[i])) {
                continue; // 跳过非重要节点
            }
            
            const node = this.nodes[i];
            if (!node || !node.nodeId) continue; // 跳过无效节点
            
            const status = this.options.nodeStatusMap[node.nodeId] || 'default';
            elements[index++] = {
                data: {
                    id: node.nodeId,
                    label: node.nodeName || node.nodeId,
                    taskConfigId: node.taskConfigId,
                    status: status,
                    // 在性能模式下简化参数数据
                    parameters: this.options._performanceMode ? null : (node.parameters || {}),
                    // 在性能模式下不保存完整原始数据
                    originalData: this.options._performanceMode ? 
                        { nodeId: node.nodeId, nodeName: node.nodeName, taskConfigId: node.taskConfigId } : node
                },
                classes: status.toLowerCase()
            };
        }
        
        // 添加边
        for (let i = 0; i < this.edges.length; i++) {
            const edge = this.edges[i];
            if (!edge || !edge.fromNodeId || !edge.toNodeId) continue; // 跳过无效边
            
            // 在极限性能模式下，仅保留关联到可见节点的边
            if (isExtremePerfMode) {
                const fromNodeVisible = this.isNodeVisible(edge.fromNodeId, sampleRate);
                const toNodeVisible = this.isNodeVisible(edge.toNodeId, sampleRate);
                if (!fromNodeVisible && !toNodeVisible) continue;
            }
            
            const label = edge.expression || edge.condition || '';
            const priority = edge.priority !== undefined ? `P:${edge.priority}` : '';
            // 优化字符串连接操作
            let displayLabel = '';
            if (!this.options._performanceMode) {
                if (label) {
                    displayLabel = label;
                    if (priority) displayLabel += '\n' + priority;
                } else if (priority) {
                    displayLabel = priority;
                }
            }
            
            elements[index++] = {
                data: {
                    id: `${edge.fromNodeId}-${edge.toNodeId}`,
                    source: edge.fromNodeId,
                    target: edge.toNodeId,
                    label: displayLabel,
                    // 在性能模式下简化数据
                    expression: this.options._performanceMode ? null : edge.expression,
                    condition: this.options._performanceMode ? null : edge.condition,
                    priority: edge.priority,
                    // 在性能模式下不保存完整原始数据
                    originalData: this.options._performanceMode ? 
                        { fromNodeId: edge.fromNodeId, toNodeId: edge.toNodeId } : edge
                }
            };
        }
        
        // 只返回有效元素
        return elements.slice(0, index);
    }
    
    /**
     * 判断一个节点是否是"重要"节点（即使在抽样模式下也应该保留）
     */
    isImportantNode(node) {
        if (!node) return false;
        // 判断节点是否有状态或者是开始/结束节点
        return (this.options.nodeStatusMap[node.nodeId] && 
                this.options.nodeStatusMap[node.nodeId] !== 'default') || 
               node.nodeId.toLowerCase().includes('start') ||
               node.nodeId.toLowerCase().includes('end');
    }
    
    /**
     * 判断一个节点在抽样下是否可见
     */
    isNodeVisible(nodeId, sampleRate) {
        if (!nodeId) return false;
        const nodeIndex = this.nodes.findIndex(n => n.nodeId === nodeId);
        if (nodeIndex === -1) return false;
        
        return nodeIndex % sampleRate === 0 || this.isImportantNode(this.nodes[nodeIndex]);
    }

    /**
     * 更新图表数据并重新渲染
     */
    updateData(nodes, edges, nodeStatusMap = null) {
        this.nodes = Array.isArray(nodes) ? nodes : [];
        this.edges = Array.isArray(edges) ? edges : [];
        
        if (nodeStatusMap) {
            this.options.nodeStatusMap = nodeStatusMap;
        }
        
        // 添加大型工作流处理逻辑
        const totalElements = this.getTotalElementCount();
        if (totalElements > this.options.performance.largeGraphThreshold) {
            console.warn(`处理大型工作流 (${totalElements} 个元素), 正在优化渲染...`);
            
            // 考虑禁用动画和工具提示以提高性能
            if (this.options.autoOptimize || 
                window.confirm(`检测到大型工作流 (${totalElements} 个元素)，这可能导致浏览器响应缓慢。\n是否切换到性能模式？`)) {
                // 设置简化显示模式
                this.options._performanceMode = true;
                
                // 超大工作流特殊处理
                if (totalElements > this.options.performance.extremelyLargeGraphThreshold) {
                    console.warn(`检测到超大型工作流 (${totalElements} 个元素), 启用极限性能优化...`);
                    this.options._extremePerformanceMode = true;
                }
            }
        } else {
            this.options._performanceMode = false;
            this.options._extremePerformanceMode = false;
        }
        
        // 使用异步渲染以避免阻塞UI
        if (totalElements > this.options.performance.largeGraphThreshold) {
            // 显示加载指示器
            const loadingDiv = document.createElement('div');
            loadingDiv.className = 'loading-indicator';
            loadingDiv.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 正在渲染大型工作流图...';
            this.container.appendChild(loadingDiv);
            
            setTimeout(() => {
                this.renderGraph();
                // 移除加载指示器
                if (loadingDiv.parentNode) {
                    loadingDiv.parentNode.removeChild(loadingDiv);
                }
            }, 100);
        } else {
            this.renderGraph();
        }
    }

    /**
     * 更新节点状态
     */
    updateNodeStatus(nodeId, status) {
        if (!this.cy) return;
        
        const node = this.cy.$id(nodeId);
        if (node.length) {
            // 移除所有可能的状态类
            node.removeClass('success running failed timed-out skipped');
            // 添加新的状态类
            node.addClass(status.toLowerCase());
            // 更新状态映射
            this.options.nodeStatusMap[nodeId] = status;
        }
    }

    /**
     * 渲染/重新渲染图表
     */
    renderGraph() {
        if (this.cy) {
            try {
                // 使用批处理模式减少重绘次数，提高性能
                this.cy.startBatch();
                
                // 如果图表已存在，更新元素
                this.cy.elements().remove();
                
                // 分批添加元素，避免一次性处理过多元素导致的内存问题
                const elements = this.getViewableElements();
                const BATCH_SIZE = this.options.performance.batchSize;
                
                // 如果元素数量较少，直接添加
                if (elements.length <= BATCH_SIZE) {
                    this.cy.add(elements);
                } else {
                    // 否则分批添加
                    let addedElements = 0;
                    for (let i = 0; i < elements.length; i += BATCH_SIZE) {
                        const batch = elements.slice(i, i + BATCH_SIZE);
                        this.cy.add(batch);
                        addedElements += batch.length;
                        
                        // 在添加大量元素时，定期暂停以让UI有响应机会
                        if (i > 0 && i % (BATCH_SIZE * 10) === 0) {
                            // 强制重绘进度
                            this.cy.endBatch();
                            this.cy.startBatch();
                            
                            // 更新进度信息
                            if (this.container.querySelector('.progress-info')) {
                                this.container.querySelector('.progress-info').textContent = 
                                    `渲染进度: ${Math.round((addedElements / elements.length) * 100)}%`;
                            } else {
                                const progressDiv = document.createElement('div');
                                progressDiv.className = 'progress-info';
                                progressDiv.textContent = `渲染进度: ${Math.round((addedElements / elements.length) * 100)}%`;
                                progressDiv.style.position = 'absolute';
                                progressDiv.style.top = '10px';
                                progressDiv.style.right = '10px';
                                progressDiv.style.background = 'rgba(255,255,255,0.8)';
                                progressDiv.style.padding = '5px';
                                progressDiv.style.borderRadius = '3px';
                                progressDiv.style.zIndex = '1000';
                                this.container.appendChild(progressDiv);
                            }
                        }
                    }
                    
                    // 移除进度信息
                    if (this.container.querySelector('.progress-info')) {
                        this.container.querySelector('.progress-info').remove();
                    }
                }
                
                // 重新应用布局，设置合理的动画选项
                const totalElements = this.getTotalElementCount();
                const isLargeGraph = totalElements > this.options.performance.largeGraphThreshold;
                const isExtremelyLargeGraph = totalElements > this.options.performance.extremelyLargeGraphThreshold;
                
                const layout = this.cy.layout({
                    name: this.options.layout,
                    rankDir: 'TB',
                    padding: 50,
                    animate: !isLargeGraph && elements.length < this.options.performance.maxElementsForAnimation,
                    animationDuration: isLargeGraph ? 0 : 
                        (elements.length < this.options.performance.maxElementsForAnimation / 2 ? 500 : 0),
                    refresh: isExtremelyLargeGraph ? 10 : 20, // 降低刷新频率以减少性能消耗
                    fit: true,
                    nodeDimensionsIncludeLabels: !isExtremelyLargeGraph,
                    // 针对大型图表的额外优化
                    randomize: false,
                    maxSimulationTime: isExtremelyLargeGraph ? 2000 : 
                        (isLargeGraph ? 3000 : 4000),
                    // 对于超大型图表，使用更紧凑的布局
                    spacingFactor: isExtremelyLargeGraph ? 0.8 : 1.2
                });
                
                layout.run();
                
                // 结束批处理
                this.cy.endBatch();
                
                this.fitGraph();
                
                // 清理内存
                setTimeout(() => this.cleanupMemory(), 1000);
            } catch (error) {
                console.error('渲染图表时发生错误:', error);
                // 结束批处理以防止状态不一致
                try {
                    this.cy.endBatch();
                } catch (e) {
                    // 忽略结束批处理时的错误
                }
                
                // 显示错误消息
                const errorDiv = document.createElement('div');
                errorDiv.className = 'alert alert-warning';
                errorDiv.innerHTML = `
                    <i class="fas fa-exclamation-triangle"></i>
                    渲染图表时发生错误: ${error.message}
                    <button class="btn btn-sm btn-outline-secondary ml-2" onclick="this.parentNode.remove();">关闭</button>
                `;
                this.container.appendChild(errorDiv);
            }
        } else {
            // 如果图表不存在，初始化
            this.init();
        }
    }

    /**
     * 设置工具提示功能
     */
    setupTooltips() {
        if (!this.cy) return;
        
        // 在性能模式下，如果元素太多则禁用工具提示以提高性能
        if (this.options._performanceMode && 
            this.getTotalElementCount() > this.options.performance.maxElementsForTooltips) {
            console.log('由于元素数量过多，已禁用工具提示以提高性能');
            return;
        }
        
        // 移除任何现有的事件处理器以避免重复
        this.cy.off('mouseover', 'node');
        this.cy.off('mouseover', 'edge');
        this.cy.off('mouseout', 'node, edge');
        this.cy.off('mousemove', 'node, edge');
        
        // 定义防抖函数，减少工具提示更新频率
        const debounce = (fn, delay) => {
            let timer = null;
            return function(...args) {
                if (timer) clearTimeout(timer);
                timer = setTimeout(() => {
                    fn.apply(this, args);
                    timer = null;
                }, delay);
            };
        };
        
        // 移动工具提示的防抖函数
        const moveTooltip = debounce((event) => {
            this.tooltip.style.left = `${event.renderedPosition.x + 10}px`;
            this.tooltip.style.top = `${event.renderedPosition.y + 10}px`;
        }, 50);
        
        this.cy.on('mouseover', 'node', event => {
            const node = event.target;
            const nodeData = node.data();
            const status = nodeData.status || 'unknown';
            const parameters = nodeData.parameters || {};
            
            let tooltipContent = `
                <strong>${nodeData.label || nodeData.id}</strong><br>
                状态: ${status}<br>
                任务ID: ${nodeData.taskConfigId || 'N/A'}
            `;
            
            if (Object.keys(parameters).length) {
                tooltipContent += '<br>参数:<br>';
                Object.entries(parameters).forEach(([key, value]) => {
                    tooltipContent += `${key}: ${JSON.stringify(value)}<br>`;
                });
            }
            
            this.tooltip.innerHTML = tooltipContent;
            this.tooltip.style.display = 'block';
            this.tooltip.style.left = `${event.renderedPosition.x + 10}px`;
            this.tooltip.style.top = `${event.renderedPosition.y + 10}px`;
        });
        
        this.cy.on('mouseover', 'edge', event => {
            const edge = event.target;
            const edgeData = edge.data();
            
            let tooltipContent = `
                <strong>从 ${edgeData.source} 到 ${edgeData.target}</strong><br>
            `;
            
            if (edgeData.expression) {
                tooltipContent += `表达式: ${edgeData.expression}<br>`;
            }
            
            if (edgeData.condition) {
                tooltipContent += `条件: ${edgeData.condition}<br>`;
            }
            
            if (edgeData.priority !== undefined) {
                tooltipContent += `优先级: ${edgeData.priority}`;
            }
            
            this.tooltip.innerHTML = tooltipContent;
            this.tooltip.style.display = 'block';
            this.tooltip.style.left = `${event.renderedPosition.x + 10}px`;
            this.tooltip.style.top = `${event.renderedPosition.y + 10}px`;
        });
        
        this.cy.on('mouseout', 'node, edge', () => {
            this.tooltip.style.display = 'none';
        });
        
        this.cy.on('mousemove', 'node, edge', event => {
            moveTooltip(event);
        });
    }

    /**
     * 注册事件监听器
     */
    registerEventListeners() {
        if (!this.cy) return;
        
        // 移除任何现有的事件处理器以避免重复
        this.cy.off('tap', 'node');
        this.cy.off('tap', 'edge');
        
        // 节点点击事件
        if (typeof this.options.onNodeClick === 'function') {
            this.cy.on('tap', 'node', event => {
                const node = event.target;
                this.options.onNodeClick(node.data().originalData, node);
            });
        }
        
        // 边点击事件
        if (typeof this.options.onEdgeClick === 'function') {
            this.cy.on('tap', 'edge', event => {
                const edge = event.target;
                this.options.onEdgeClick(edge.data().originalData, edge);
            });
        }
        
        // 高亮相关节点和边（仅在非性能模式时启用）
        if (!this.options._performanceMode) {
            this.cy.on('mouseover', 'node', event => {
                if (this.options.readOnly) return; // 只读模式不高亮
                
                const node = event.target;
                const connectedEdges = node.connectedEdges();
                const connectedNodes = connectedEdges.connectedNodes();
                
                // 淡化所有元素
                this.cy.elements().addClass('faded');
                
                // 高亮当前节点及其相关节点和边
                node.removeClass('faded');
                connectedEdges.removeClass('faded');
                connectedNodes.removeClass('faded');
                
                // 为边添加额外高亮
                connectedEdges.addClass('highlighted');
            });
            
            // 移除高亮
            this.cy.on('mouseout', 'node', () => {
                if (this.options.readOnly) return;
                
                this.cy.elements().removeClass('faded highlighted');
            });
        }
    }

    /**
     * 销毁图表实例
     */
    destroy() {
        if (this.cy) {
            this.cy.destroy();
            this.cy = null;
        }
        
        if (this.tooltip && this.tooltip.parentNode) {
            this.tooltip.parentNode.removeChild(this.tooltip);
        }

        // 清理内存引用
        this.nodes = [];
        this.edges = [];
        this.container = null;
    }

    /**
     * 辅助内存管理，减少内存占用
     */
    cleanupMemory() {
        if (!this.cy) return;
        
        // 对于超大型图表进行更积极的内存清理
        const isExtremelyLargeGraph = this.getTotalElementCount() > this.options.performance.extremelyLargeGraphThreshold;
        
        // 清理不需要的缓存
        this.cy.scratch('_cleanupCount', (this.cy.scratch('_cleanupCount') || 0) + 1);
        
        // 每隔5次刷新触发垃圾回收（超大图表每隔2次）
        if ((this.cy.scratch('_cleanupCount') % (isExtremelyLargeGraph ? 2 : 5)) === 0) {
            // 清理可能的内部缓存
            this.cy.elements().forEach(ele => {
                ele.scratch('_temp_data', null);
                // 对于超大图表，移除不必要的数据以节省内存
                if (isExtremelyLargeGraph && ele.data('originalData')) {
                    const essentialData = {};
                    const original = ele.data('originalData');
                    
                    // 只保留必要的属性
                    if (ele.isNode()) {
                        essentialData.nodeId = original.nodeId;
                        essentialData.nodeName = original.nodeName;
                        essentialData.taskConfigId = original.taskConfigId;
                    } else {
                        essentialData.fromNodeId = original.fromNodeId;
                        essentialData.toNodeId = original.toNodeId;
                        essentialData.expression = original.expression;
                    }
                    
                    // 替换为精简版本
                    ele.data('originalData', essentialData);
                }
            });
            
            // 建议浏览器进行垃圾回收
            if (window.gc) {
                try {
                    window.gc();
                } catch (e) {
                    // 忽略错误
                }
            }
            
            console.log('DAG图内存清理完成');
        }
    }
}

// 导出工作流DAG图查看器
window.WorkflowDagViewer = WorkflowDagViewer;
