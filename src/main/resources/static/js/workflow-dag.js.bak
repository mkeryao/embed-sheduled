/**
 * 工作流DAG图可视化组件
 * 用于可视化工作流任务的依赖关系和执行状态
 */
class WorkflowDagViewer {
    constructor(containerId, options = {}) {
        this.containerId = containerId;
        this.container = document.getElementById(containerId);
        this.cy = null; // Cytoscape实例
        this.nodes = [];
        this.edges = [];
        this.options = Object.assign({
            layout: 'dagre', // 默认使用dagre布局
            nodeStatusMap: {}, // 节点状态映射
            readOnly: false, // 是否只读模式
            onNodeClick: null, // 节点点击回调
            onEdgeClick: null, // 边点击回调
           // 性能相关配置选项
           performance: {
               maxElementsForAnimation: 200,     // 动画元素数量上限
               maxElementsForTooltips: 500,      // 工具提示元素数量上限
               batchSize: 100,                   // 批处理大小
               largeGraphThreshold: 1000,        // 大型图阈值
               extremelyLargeGraphThreshold: 5000 // 超大型图阈值
           },
           // 自动优化内存选项
           autoOptimize: true
        }, options);

        // 初始化工具提示元素
        this.tooltip = document.createElement('div');
        this.tooltip.classList.add('cy-tooltip');
        this.tooltip.style.display = 'none';
        document.body.appendChild(this.tooltip);

        // 绑定this到方法
        this.renderGraph = this.renderGraph.bind(this);
        this.updateData = this.updateData.bind(this);
        this.updateNodeStatus = this.updateNodeStatus.bind(this);
        this.getViewableElements = this.getViewableElements.bind(this);
        this.registerEventListeners = this.registerEventListeners.bind(this);
        this.setupTooltips = this.setupTooltips.bind(this);
        this.fitGraph = this.fitGraph.bind(this);
        this.centerGraph = this.centerGraph.bind(this);
        this.exportPNG = this.exportPNG.bind(this);
    }

    /**
     * 初始化DAG图
     */
    init() {
        if (!this.container) {
            console.error('容器元素不存在:', this.containerId);
            return;
        }

        // 创建控制按钮
        this.createControlButtons();

        try {
            // 创建Cytoscape实例
            this.cy = cytoscape({
                container: this.container,
                style: this.getCytoscapeStyle(),
                layout: {
                    name: this.options.layout,
                    rankDir: 'TB', // 从上到下的方向
                    padding: 50,
                    animate: true
                },
                elements: this.getViewableElements(),
                // 恢复默认的滚轮敏感度，以避免异常缩放行为
                wheelSensitivity: 0.1,
                // 设置最小和最大缩放限制以避免内存问题
                minZoom: 0.1,
                maxZoom: 3.0,
                // 加速渲染设置
                textureOnViewport: this.getTotalElementCount() > this.options.performance.largeGraphThreshold,
                hideEdgesOnViewport: this.getTotalElementCount() > this.options.performance.largeGraphThreshold,
                motionBlur: false,
                pixelRatio: this.getTotalElementCount() > this.options.performance.extremelyLargeGraphThreshold ? 1 : 'auto'
            });

            // 设置工具提示和事件监听器
            this.setupTooltips();
            this.registerEventListeners();

            // 初始布局
            this.fitGraph();
        } catch (error) {
            console.error('初始化DAG图失败:', error);
            this.container.innerHTML = `
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> 
                    无法初始化工作流图: ${error.message}
                </div>`;
        }
    }

    /**
     * 获取Cytoscape样式配置
     */
    getCytoscapeStyle() {
        return [
            {
                selector: 'node',
                style: {
                    'background-color': '#6c757d',
                    'label': 'data(label)',
                    'text-valign': 'center',
                    'text-halign': 'center',
                    'color': 'white',
                    'text-wrap': 'wrap',
                    'text-max-width': '80px',
                    'font-size': '12px',
                    'width': '100px',
                    'height': '40px',
                    'border-width': 1,
                    'border-color': '#555',
                    'shape': 'roundrectangle',
                }
            },
            {
                selector: 'edge',
                style: {
                    'width': 2,
                    'line-color': '#ccc',
                    'target-arrow-color': '#ccc',
                    'target-arrow-shape': 'triangle',
                    'curve-style': 'bezier',
                    'label': 'data(label)',
                    'text-rotation': 'autorotate',
                    'font-size': '10px',
                    'color': '#666',
                    'text-background-color': 'white',
                    'text-background-opacity': 0.8,
                    'text-background-padding': '2px'
                }
            },
            {
                selector: '.success',
                style: {
                    'background-color': '#28a745'
                }
            },
            {
                selector: '.running',
                style: {
                    'background-color': '#007bff'
                }
            },
            {
                selector: '.failed',
                style: {
                    'background-color': '#dc3545'
                }
            },
            {
                selector: '.timed-out',
                style: {
                    'background-color': '#ffc107',
                    'color': 'black'
                }
            },
            {
                selector: '.skipped',
                style: {
                    'background-color': '#6c757d'
                }
            },
            {
                selector: '.highlighted',
                style: {
                    'line-color': '#007bff',
                    'target-arrow-color': '#007bff',
                    'width': 3,
                    'opacity': 1
                }
            },
            {
                selector: '.faded',
                style: {
                    'opacity': 0.4
                }
            }
        ];
    }

    /**
     * 创建控制按钮
     */
    createControlButtons() {
        // 创建按钮容器
        const controlsDiv = document.createElement('div');
        controlsDiv.className = 'workflow-controls';
        
        // 创建控制按钮
        const fitButton = document.createElement('button');
        fitButton.className = 'btn btn-sm btn-outline-secondary';
        fitButton.innerHTML = '<i class="fas fa-expand-arrows-alt"></i> 适配';
        fitButton.addEventListener('click', this.fitGraph);
        
        const centerButton = document.createElement('button');
        centerButton.className = 'btn btn-sm btn-outline-secondary';
        centerButton.innerHTML = '<i class="fas fa-compress-arrows-alt"></i> 居中';
        centerButton.addEventListener('click', this.centerGraph);
        
        const exportButton = document.createElement('button');
        exportButton.className = 'btn btn-sm btn-outline-secondary';
        exportButton.innerHTML = '<i class="fas fa-download"></i> 导出';
        exportButton.addEventListener('click', this.exportPNG);
        
        // 添加按钮到容器
        controlsDiv.appendChild(fitButton);
        controlsDiv.appendChild(centerButton);
        controlsDiv.appendChild(exportButton);
        
        // 将控制按钮添加到图容器
        this.container.appendChild(controlsDiv);
    }

    /**
     * 适配图形到视图
     */
    fitGraph() {
        if (this.cy) {
            this.cy.fit();
        }
    }

    /**
     * 获取元素总数
     */
    getTotalElementCount() {
        return this.nodes.length + this.edges.length;
    }

    /**
     * 异步初始化图表
     * 使用setTimeout将初始化任务放入事件队列，避免阻塞UI
     */
    asyncInit() {
        if (!this.container) {
            console.error('容器元素不存在:', this.containerId);
            return Promise.reject('容器元素不存在');
        }

        // 显示加载指示器
        this.container.innerHTML = '<div class="loading-indicator"><i class="fas fa-spinner fa-spin"></i> 正在初始化工作流图...</div>';

        return new Promise((resolve, reject) => {
            setTimeout(() => {
                try {
                    this.init();
                    resolve(this.cy);
                } catch (error) {
                    console.error('异步初始化DAG图失败:', error);
                    reject(error);
                }
            }, 50); // 给UI线程一些时间来渲染
        });
    }

    /**
     * 将图形居中显示
     */
    centerGraph() {
        if (this.cy) {
            this.cy.center();
        }
    }

    /**
     * 导出PNG图像
     */
    exportPNG() {
        if (!this.cy) return;
        
        try {
            const png = this.cy.png({
                output: 'blob',
                bg: 'white',
                scale: 2
            });
            
            const link = document.createElement('a');
            link.href = URL.createObjectURL(png);
            link.download = `工作流图-${new Date().toISOString().slice(0, 19).replace(/[T:]/g, '-')}.png`;
            link.click();
        } catch (error) {
            console.error('导出PNG失败:', error);
            alert('导出失败: ' + error.message);
        }
    }

    /**
     * 获取可视化元素（节点和边）
     */
    getViewableElements() {
        // 使用一次性预分配内存空间，避免频繁的内存分配
        const totalElements = this.nodes.length + this.edges.length;
        const elements = new Array(totalElements);
        let index = 0;
        
        // 添加节点
        for (let i = 0; i < this.nodes.length; i++) {
            const node = this.nodes[i];
            if (!node || !node.nodeId) continue; // 跳过无效节点
            
            const status = this.options.nodeStatusMap[node.nodeId] || 'default';
            elements[index++] = {
                data: {
                    id: node.nodeId,
                    label: node.nodeName || node.nodeId,
                    taskConfigId: node.taskConfigId,
                    status: status,
                    parameters: node.parameters || {},
                    originalData: node
                },
                classes: status.toLowerCase()
            };
        }
        
        // 添加边
        for (let i = 0; i < this.edges.length; i++) {
            const edge = this.edges[i];
            if (!edge || !edge.fromNodeId || !edge.toNodeId) continue; // 跳过无效边
            
            const label = edge.expression || edge.condition || '';
            const priority = edge.priority !== undefined ? `P:${edge.priority}` : '';
            // 优化字符串连接操作
            let displayLabel = '';
            if (label) {
                displayLabel = label;
                if (priority) displayLabel += '\n' + priority;
            } else if (priority) {
                displayLabel = priority;
            }
            
            elements[index++] = {
                data: {
                    id: `${edge.fromNodeId}-${edge.toNodeId}`,
                    source: edge.fromNodeId,
                    target: edge.toNodeId,
                    label: displayLabel,
                    expression: edge.expression,
                    condition: edge.condition,
                    priority: edge.priority,
                    originalData: edge
                }
            };
        }
        
        // 只返回有效元素
        return elements.slice(0, index);
    }

    /**
     * 更新图表数据并重新渲染
     */
    updateData(nodes, edges, nodeStatusMap = null) {
        this.nodes = Array.isArray(nodes) ? nodes : [];
        this.edges = Array.isArray(edges) ? edges : [];
        
        if (nodeStatusMap) {
            this.options.nodeStatusMap = nodeStatusMap;
        }
        
        // 添加大型工作流处理逻辑
        const totalElements = this.nodes.length + this.edges.length;
        if (totalElements > this.options.performance.largeGraphThreshold) {
            console.warn(`处理大型工作流 (${totalElements} 个元素), 正在优化渲染...`);
            
            // 考虑禁用动画和工具提示以提高性能
            if (this.options.autoOptimize || 
                window.confirm(`检测到大型工作流 (${totalElements} 个元素)，这可能导致浏览器响应缓慢。\n是否切换到性能模式？`)) {
                // 设置简化显示模式
                this.options._performanceMode = true;
                
                // 超大工作流特殊处理
                if (totalElements > this.options.performance.extremelyLargeGraphThreshold) {
                    console.warn(`检测到超大型工作流 (${totalElements} 个元素), 启用极限性能优化...`);
                    this.options._extremePerformanceMode = true;
                }
            }
        } else {
            this.options._performanceMode = false;
            this.options._extremePerformanceMode = false;
        }
        
        // 使用异步渲染以避免阻塞UI
        if (totalElements > this.options.performance.largeGraphThreshold) {
            // 显示加载指示器
            const loadingDiv = document.createElement('div');
            loadingDiv.className = 'loading-indicator';
            loadingDiv.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 正在渲染大型工作流图...';
            this.container.appendChild(loadingDiv);
            
            setTimeout(() => {
                this.renderGraph();
                // 移除加载指示器
                if (loadingDiv.parentNode) {
                    loadingDiv.parentNode.removeChild(loadingDiv);
                }
            }, 100);
        } else {
            this.renderGraph();
        }
    }

    /**
     * 更新节点状态
     */
    updateNodeStatus(nodeId, status) {
        if (!this.cy) return;
        
        const node = this.cy.$id(nodeId);
        if
